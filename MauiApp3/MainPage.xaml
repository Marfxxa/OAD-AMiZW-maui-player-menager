<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="29" Spacing="12">

            <Label Text="Dodaj gracza"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Entry Placeholder="Nazwa gracza"
                   Text="{Binding PlayerName}" />

            <Entry Placeholder="Poziom gracza"
                   Keyboard="Numeric"
                   Text="{Binding PlayerLevel}" />

            <Button Text="Dodaj gracza"
                    Command="{Binding AddPlayerCommandButton}" />

            <Label Text="Lista graczy"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

            <CollectionView ItemsSource="{Binding Players}"
                            HeightRequest="250">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10"
                              ColumnDefinitions="50,*,100">
                            <Label Grid.Column="0"
                                   Text="{Binding Id}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}" />
                            <Label Grid.Column="2"
                                   Text="{Binding Level}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label Text="Znajdź gracza"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

            <Entry Placeholder="Podaj Id gracza"
                   Keyboard="Numeric"
                   Text="{Binding PlayerId}" />

            <Button Text="Szukaj"
                    Command="{Binding FindPlayerCommandButton}" />

            <Label Text="Wynik"
                   FontAttributes="Bold" />

            <Label Text="{Binding SearchResult}"
                   FontSize="18" />

            <Label Text="Usuń gracza"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

            <Entry Placeholder="Id gracza do usunięcia"
                   Keyboard="Numeric"
                   Text="{Binding DeletePlayerId}" />

            <Button Text="Usuń gracza"
                    Command="{Binding DeletePlayerCommandButton}"
                    BackgroundColor="#B42318"
                    TextColor="White" />

            <Label Text="Edycja gracza"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

            <Entry Placeholder="Id gracza do edycji"
                   Keyboard="Numeric"
                   Text="{Binding EditPlayerId}" />

            <Entry Placeholder="Nowa nazwa"
                   Text="{Binding EditPlayerName}" />

            <Entry Placeholder="Nowy poziom"
                   Keyboard="Numeric"
                   Text="{Binding EditPlayerLevel}" />

            <Button Text="Edytuj gracza"
                    Command="{Binding EditPlayerCommandButton}" />

            <Label Text="{Binding StatusMessage}"
                   FontSize="16"
                   Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
